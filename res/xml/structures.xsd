<?xml version="1.0"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <!-- Structures -->
    <xs:element name="Structures">
        <xs:complexType>
            <xs:sequence>
                <xs:element ref="Structure" minOccurs="1" maxOccurs="unbounded" />
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- Structure -->
    <xs:element name="Structure">
        <xs:complexType>
            <xs:attribute name="name" type="xs:string" use="required" />
            <xs:attribute name="width" type="xs:unsignedInt" use="optional" />
            <xs:attribute name="height" type="xs:unsignedInt" use="optional" />
            <xs:attribute name="margin" type="xs:unsignedInt" use="required" />
            <xs:attribute name="material" type="xs:string" use="required" />
        </xs:complexType>
    </xs:element>

</xs:schema>