<box width="100%" height="100%" styleName="ui">
    <style>
        .panel-wrapper {
            width: 100%;
            height: 100%;
            padding: -1px;
        }

        .bottom-container {
            background-color: #212121;
            vertical-align: bottom;
            width: 100%;
            padding: 2px;
        }

        .side-container {
            background-color: #212121;
            horizontal-align: right;
            padding: 2px;
        }

        .bottom-wrapper {
            width: 100%;
            height: 100%;
            vertical-align: bottom;
            border: 1px solid #666666;
            padding: 4px;
        }

        .side-wrapper {
            width: 100%;
            height: 100%;
            horizontal-align: right;
            border: 1px solid #666666;
            padding: 4px;
        }

        #playerInfo {
            height: 200px;
        }
    </style>
    <box id="panelWrapper" styleName="panel-wrapper">
        <hbox id="bottomContainer" styleName="bottom-container">
            <hbox id="bottomWrapper" styleName="bottom-wrapper"></hbox>
        </hbox>
        <vbox id="sideContainer" styleName="side-container">
            <vbox id="playerInfo" styleName="side-wrapper"></vbox>
            <vbox id="sideWrapper" styleName="side-wrapper">
                <slabel id="zoom"/>
                <llabel id="camx"/>
                <xllabel id="posx"/>
            </vbox>
        </vbox>
    </box>
</box>