<box width="100%" height="100%" style="padding: 8px;">
    <style>
    .options-wrapper {
        width: 100%;
        height: 100%;
        background-color: #212121;
        padding: 8px;
    }

    .button-controls {
        width: 100%;
        height: auto;
    }

    .button-wrapper {
        width: 100%;
    }

    .settings-page .accordion-button {
        height: 32px;
    }

    .setting-group {
        width: 100%;
        padding-top: 16px;
        padding-bottom: 16px;
    }

    .setting-row {
        width: 100%;
        height: 50px;
        padding: 2px;
    }

    .setting-name {
        width: 50%;
        vertical-align: center;
        horizontal-align: left;
        color: red;
    }

    .slot {
        width: 50%;
        height: 100%;
        vertical-align: center;
        horizontal-align: right;
    }

    .setting-value {
        width: 100%;
        vertical-align: center;
        horizontal-align: left;
    }

    .checkbox-value {
        width: 32px;
        height: 32px;
    }

    .option-stepper {
        vertical-align: center;
    }
    </style>
    <vbox styleName="options-wrapper">
        <vbox styleName="page-wrapper">
            <section-header text="Settings" styleName="page-title"/>
            <vbox styleName="page-body">
                <accordion id="ac1" width="100%" height="100%" styleName="settings-page">
                    <vbox id="general" text="General" styleName="setting-group"></vbox>
                    <vbox id="display" text="Display" styleName="setting-group"></vbox>
                    <vbox id="graphics" text="Graphics" styleName="setting-group"></vbox>
                    <vbox id="audio" text="Audio" styleName="setting-group"></vbox>
                    <vbox id="input" text="Input" styleName="setting-group"></vbox>
                </accordion>
            </vbox>
        </vbox>
        <box styleName="button-controls">
            <hbox styleName="button-wrapper">
                <button id="btnBack" text="Back"/>
                <button id="btnSave" text="Save"/>
            </hbox>
        </box>
    </vbox>
</box>